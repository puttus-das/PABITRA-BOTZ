{
  "name": "pabitra-botz",
  "description": "PABITRA-BOT V50 WhatsApp and Telegram bot",
  "repository": "https://github.com/puttus-das/PABITRA-BOTZ",
  "logo": "https://raw.githubusercontent.com/puttus-das/PABITRA-BOTZ/main/plugins/bin/tg_dp.jpg",
  "keywords": ["whatsapp", "telegram", "baileys", "nodejs"],
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "BOT_TOKEN_TELEGRAM": {
      "description": "Telegram bot token from @BotFather",
      "required": true
    },
    "TG_GROUP_ID": {
      "description": "Telegram group ID, for example -1001234567890",
      "required": true
    },
    "WEBSITE_URL": {
      "description": "Vercel website origin, for example https://pabitra-botz.vercel.app",
      "required": true
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
